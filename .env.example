# Required: https://rawg.io/apidocs
RAWG_API_KEY=

# X (Twitter) API: https://console.x.com
# Leave empty to run in dry-run mode locally (nothing is posted, history is not updated).
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Optional: force "popular" or "hidden-gem" instead of the day's default
RECOMMENDATION_MODE=
