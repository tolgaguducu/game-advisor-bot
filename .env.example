# Game sources: set at least one. RAWG is tried first, IGDB is used when RAWG is down.
# RAWG: https://rawg.io/apidocs
RAWG_API_KEY=
# IGDB: app credentials from https://dev.twitch.tv/console (free for non-commercial use)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Platform credentials. Leave a platform's keys empty to run it in dry-run mode locally
# (nothing is posted, history is not updated).

# X (Twitter) API: https://console.x.com  →  npm start -- x
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# Bluesky: handle and an app password (Settings → Privacy and Security → App Passwords)  →  npm start -- bluesky
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Optional: force "popular" or "hidden-gem" instead of the day's default
RECOMMENDATION_MODE=
